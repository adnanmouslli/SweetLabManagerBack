generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                       @id @default(autoincrement())
  username           String                    @unique
  password           String
  roles              Role[]                    @default([EMPLOYEE])
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  fundTransfers      FundTransferLog[]
  invoices           Invoice[]
  confirmedTransfers MainFundTransferRequest[] @relation("ConfirmedBy")
  transferRequests   MainFundTransferRequest[]
  orders             Order[]
  acceptedTransfers  PendingShiftTransfer[]    @relation("AcceptedTransfers")
  requestedTransfers PendingShiftTransfer[]    @relation("RequestedTransfers")
  shifts             Shift[]
}

model Shift {
  id               Int               @id @default(autoincrement())
  shiftType        ShiftType
  status           ShiftStatus       @default(open)
  openTime         DateTime
  closeTime        DateTime?
  differenceStatus DifferenceStatus?
  differenceValue  Float?
  employeeId       Int
  invoices         Invoice[]
  employee         User              @relation(fields: [employeeId], references: [id])

  @@map("shifts")
}

model Fund {
  id             Int               @id @default(autoincrement())
  fundType       FundType
  currentBalance Float             @default(0)
  lastUpdate     DateTime          @updatedAt
  transfersFrom  FundTransferLog[] @relation("FromFund")
  transfersTo    FundTransferLog[] @relation("ToFund")
  invoices       Invoice[]

  @@map("funds")
}

model FundTransferLog {
  id              Int      @id @default(autoincrement())
  amount          Float
  fromFundId      Int
  toFundId        Int
  transferredById Int
  transferredAt   DateTime @default(now())
  metadata        String?
  fromFund        Fund     @relation("FromFund", fields: [fromFundId], references: [id])
  toFund          Fund     @relation("ToFund", fields: [toFundId], references: [id])
  transferredBy   User     @relation(fields: [transferredById], references: [id])

  @@map("fund_transfer_logs")
}

model ItemGroup {
  id          Int      @id @default(autoincrement())
  name        String
  type        ItemType
  description String?
  items       Item[]

  @@map("item_groups")
}

model Item {
  id           Int           @id @default(autoincrement())
  name         String
  type         ItemType
  units        Json?
  defaultUnit  String
  cost         Float?
  price        Float
  description  String?
  groupId      Int
  invoiceItems InvoiceItem[]
  group        ItemGroup     @relation(fields: [groupId], references: [id])
  orderItems   OrderItem[]

  @@map("items")
}

model Invoice {
  id               Int                   @id @default(autoincrement())
  invoiceNumber    String                @unique
  invoiceType      InvoiceType
  invoiceCategory  InvoiceCategory
  customerId       Int?
  totalAmount      Float
  discount         Float                 @default(0)
  additionalAmount Float                 @default(0)
  paidStatus       Boolean
  paymentDate      DateTime?
  createdAt        DateTime              @default(now())
  notes            String?
  isBreak          Boolean               @default(false)
  fundId           Int
  shiftId          Int
  employeeId       Int
  relatedDebtId    Int?
  trayCount        Int                   @default(0)
  relatedAdvanceId Int?
  items            InvoiceItem[]
  customer         Customer?             @relation(fields: [customerId], references: [id])
  employee         User                  @relation(fields: [employeeId], references: [id])
  fund             Fund                  @relation(fields: [fundId], references: [id])
  relatedAdvance   Advance?              @relation("AdvanceInvoices", fields: [relatedAdvanceId], references: [id])
  relatedDebt      Debt?                 @relation(fields: [relatedDebtId], references: [id])
  shift            Shift                 @relation(fields: [shiftId], references: [id])
  order            Order?
  expenseTransfer  PendingShiftTransfer? @relation("ExpenseInvoiceTransfer")
  incomeTransfer   PendingShiftTransfer? @relation("IncomeInvoiceTransfer")
  trayTracking     TrayTracking?

  @@map("invoices")
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  quantity  Float
  unitPrice Float
  subTotal  Float
  unit      String
  invoiceId Int
  itemId    Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  item      Item    @relation(fields: [itemId], references: [id])

  @@map("invoice_items")
}

model TrayTracking {
  id         Int        @id @default(autoincrement())
  customerId Int
  totalTrays Int
  status     TrayStatus @default(pending)
  createdAt  DateTime   @default(now())
  returnedAt DateTime?
  notes      String?
  invoiceId  Int        @unique
  customer   Customer   @relation(fields: [customerId], references: [id])
  invoice    Invoice    @relation(fields: [invoiceId], references: [id])

  @@map("tray_tracking")
}

model Debt {
  id              Int        @id @default(autoincrement())
  customerId      Int
  totalAmount     Float
  remainingAmount Float
  discount        Float      @default(0)
  createdAt       DateTime   @default(now())
  lastPaymentDate DateTime?
  status          DebtStatus @default(active)
  notes           String?
  customer        Customer   @relation(fields: [customerId], references: [id])
  relatedInvoices Invoice[]

  @@map("debts")
}

model CustomerCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]

  @@map("customer_categories")
}

model Customer {
  id         Int               @id @default(autoincrement())
  name       String
  phone      String?            @unique
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  categoryId Int?
  advances   Advance[]
  category   CustomerCategory? @relation(fields: [categoryId], references: [id])
  debts      Debt[]
  invoices   Invoice[]
  orders     Order[]
  trays      TrayTracking[]

  @@map("customers")
}

model MainFundTransferRequest {
  id               Int       @id @default(autoincrement())
  amount           Float
  status           String
  requestedById    Int
  confirmedById    Int?
  requestedAt      DateTime  @default(now())
  confirmedAt      DateTime?
  notes            String?
  rejectionReason  String?
  expenseInvoiceId Int?
  incomeInvoiceId  Int?
  confirmedBy      User?     @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  requestedBy      User      @relation(fields: [requestedById], references: [id])

  @@map("main_fund_transfer_requests")
}

model PendingShiftTransfer {
  id               Int       @id @default(autoincrement())
  transferNumber   String    @unique
  amount           Float
  status           String
  requestedById    Int
  requestedAt      DateTime  @default(now())
  acceptedById     Int?
  acceptedAt       DateTime?
  notes            String?
  expenseInvoiceId Int?      @unique
  incomeInvoiceId  Int?      @unique
  acceptedBy       User?     @relation("AcceptedTransfers", fields: [acceptedById], references: [id])
  expenseInvoice   Invoice?  @relation("ExpenseInvoiceTransfer", fields: [expenseInvoiceId], references: [id])
  incomeInvoice    Invoice?  @relation("IncomeInvoiceTransfer", fields: [incomeInvoiceId], references: [id])
  requestedBy      User      @relation("RequestedTransfers", fields: [requestedById], references: [id])

  @@map("pending_shift_transfers")
}

model Advance {
  id              Int           @id @default(autoincrement())
  customerId      Int
  totalAmount     Float
  remainingAmount Float
  createdAt       DateTime      @default(now())
  lastPaymentDate DateTime?
  status          AdvanceStatus @default(active)
  notes           String?
  customer        Customer      @relation(fields: [customerId], references: [id])
  relatedInvoices Invoice[]     @relation("AdvanceInvoices")

  @@map("advances")
}

model OrderCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("order_categories")
}

model Order {
  id           Int           @id @default(autoincrement())
  orderNumber  String        @unique
  customerId   Int
  totalAmount  Float
  paidStatus   Boolean       @default(false)
  status       OrderStatus   @default(pending)
  createdAt    DateTime      @default(now())
  scheduledFor DateTime
  deliveryDate DateTime?
  notes        String?
  categoryId   Int
  invoiceId    Int?          @unique
  employeeId   Int
  items        OrderItem[]
  category     OrderCategory @relation(fields: [categoryId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  employee     User          @relation(fields: [employeeId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  itemId    Int
  quantity  Float
  unitPrice Float
  unit      String
  subTotal  Float
  notes     String?
  item      Item    @relation(fields: [itemId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

enum Role {
  MANAGER
  ADMIN
  ShiftManager
  TreasuryManager
  TrayManager
  EMPLOYEE
}

enum DifferenceStatus {
  surplus
  deficit
}

enum ShiftType {
  morning
  evening
}

enum ShiftStatus {
  open
  closed
}

enum FundType {
  main
  general
  booth
  university
}

enum ItemType {
  production
  raw
}

enum InvoiceType {
  income
  expense
}

enum InvoiceCategory {
  products
  direct
  debt
  advance
}

enum TrayStatus {
  pending
  returned
}

enum DebtStatus {
  active
  paid
}

enum AdvanceStatus {
  active
  completed
}

enum OrderStatus {
  pending
  processing
  ready
  delivered
  cancelled
}
